# Get a key at https://openrouter.ai/keys — creating a key is free, no card required.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Free by default: OpenRouter's tool-calling-aware free router (~20 req/min, 50/day
# on a key that's never purchased credits — fine for building/demoing).
# Swap to a paid model string (e.g. anthropic/claude-3.5-haiku) if you want higher
# throughput or better reasoning and are OK with the cost.
OPENROUTER_MODEL=openrouter/free
